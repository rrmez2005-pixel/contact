<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guestbook submission received</title>
  <link rel="stylesheet" href="/styles/styles.css">
</head>
<body>
  <%- include('partials/header') %>
  <main>
    <h1>Confirmed your submission</h1>
    <!-- stealing button CSS from form.ejs to make it look nicer -->
    <a class="btn-submit" href="/">Back to the form</a>

    <h2>Order Details</h2>
    <p>First Name: <%= submission.fname %></p>
    <p>Last Name: <%= submission.lname %></p>
    <p>Job Title: <%= submission['job-title'] %></p>
    <p>Company: <%= submission.company %></p>
    <p>LinkedIn: <%= submission.linkedin %></p>
    <p>Email: <%= submission.email %></p>
    <p>Meeting: <%= submission.meeting %></p>
    <p>Other: <%= submission.other %></p>
    <p>Message: <%= submission.message %></p>
    <p>Mail: <%= submission.mail %></p>
    <p>Email Format: <%= submission.format %></p>
    <p>Timestamp: <%= submission.timestamp.toLocaleString() %></p>
  </main>
  <%- include('partials/footer') %>
</body>
</html>