<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin</title>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
</head>
<body>
    <h1>Orders</h1>
    <table id="contact-table" class="display">
        <thead>
            <tr>
                <th>First Name: </th>
                <th>Last Name: </th>
                <th>Job: </th>
                <th>Company: </th>
                <th>LinkedIn: </th>
                <th>Email: </th>
                <th>Meeting: </th>
                <th>Other: </th>
                <th>Message: </th>
                <th>Mail: </th>
                <th>Email Format: </th>
            </tr>
        </thead>
        <tbody>
            <% submissions.forEach(form => { %>
                <tr>
                    <td>First Name: <%= form.fname %></td>
                    <td>Last Name: <%= form.lname %></td>
                    <td>Job: <%= form['job-title'] %></td>
                    <td>Company: <%= form.company %></td>
                    <td>LinkedIn: <%= form.linkedin %></td>
                    <td>Email: <%= form.email %></td>
                    <td>Meeting: <%= form.meeting %></td>
                    <td>Other: <%= form.other %></td>
                    <td>Message: <%= form.message %></td>
                    <td>Mail: <%= form.mail %></td>
                    <td>Email Format: <%= form.format %></td>
                </tr>
            <% }); %>
        </tbody>  
    </table>
    <script>
        new DataTable('#contact-table');
    </script> 
</body>
</html>